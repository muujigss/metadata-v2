ALLOW_INSECURE_HTTP_LOGIN=false
UPLOAD_DIR=public/uploads

EMAIL_HOST=
EMAIL_PORT=587
METADATA_INFO_EMAIL=
METADATA_INFO_PASSWORD=

ELASTIC_URL=
ELASTIC_USER=
ELASTIC_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
