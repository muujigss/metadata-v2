}

model lib_sector {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  img_url      String?
  feature      Int?
  is_active    Boolean?
  created_date DateTime      @default(now())
  created_user Int?
  updated_date DateTime      @default(now())
  updated_user Int?
  databases    md_database[]
