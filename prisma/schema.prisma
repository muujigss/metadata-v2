  created_user   Int?
  updated_date   DateTime      @default(now())
  updated_user   Int?
  databases      md_database[]
  users          md_users[]
  log_database   log_database[]
  file           md_file?        @relation(fields: [file_id], references: [id])
  
}

model md_indicator {
  id                         Int                           @id @default(autoincrement())
  tbl_id                     Int
  code                       String?
