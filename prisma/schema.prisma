model log_user_database {
  id           Int      @id @default(autoincrement())
  type         String
  ud_id        Int
  user_id      Int
  database_id  Int
  created_date DateTime @default(now())
  created_user Int?
  updated_date DateTime @default(now())
  updated_user Int?
  user_database md_user_database @relation(fields: [ud_id], references: [id])
  database      md_database? @relation(fields: [database_id], references: [id])
  lud_created_user md_users? @relation(fields: [created_user], references: [id])
