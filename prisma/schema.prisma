model md_file {
  id              Int              @id @default(autoincrement())
  filename        String
  type            String?
  path            String?
  size            Int?
  created_date    DateTime?        @default(now())
  created_user    Int?
  actions         md_action[]
  log_actions     log_action[]
  organizations   md_organization[]
}

model md_notif {
  id            Int      @id @default(autoincrement())
  database_id   Int?
  org_id        Int?
  action_id     Int?

  type          String?
  text          String?
  description   String?
  icon          String?
  is_view_admin Boolean  @default(false)
  is_view_user  Boolean  @default(false)

  created_date  DateTime @default(now())
  created_user  Int?
  updated_date  DateTime?
  updated_user  Int?

  database      md_database? @relation(fields: [database_id], references: [id])
  action        md_action? @relation(fields: [action_id], references: [id])
}