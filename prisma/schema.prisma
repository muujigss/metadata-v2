  created_user Int?
  updated_date DateTime   @default(now())
  updated_user Int?
  md_users     md_users[]
}

model lib_user_role {
  id           Int      @id @default(autoincrement())
  code         String?
  name         String
  created_date DateTime @default(now())
  created_user Int?
  updated_date DateTime @default(now())
  updated_user Int?
}

model log_action {
  id              Int              @id @default(autoincrement())
  file_id         Int?
  log_type        String
  action_id       Int?
  user_id         Int?
  action_type     Int?
  item_id         Int?             @unique
  item_type       String?
  description     String?
  created_date    DateTime?        @default(now())
  created_user    Int?
  updated_date    DateTime?        @default(now())
  updated_user    Int?
