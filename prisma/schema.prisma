  updated_user Int?
}

model md_organization {
  id             Int           @id @default(autoincrement())
  file_id        Int?
  type           String?
  status         String?
  name           String?
  phone          String?
  email          String?
  address        String?
  website        String?
  org_short_name String?
  img_url        String?
  is_active      Boolean?
  version        String?
